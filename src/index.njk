---
layout: base
eleventyNavigation:
  key: All Plans
  order: 1
eleventyImport:
  collections: ["sortedPlans"]
pagination:
  data: collections.sortedPlans
  size: 12
  alias: plans
meta:
  title: Bible Reading Plans Archive
  description: this is where you can find all our Bible Reading Plans.
---

{% include "today.njk" %}

<main class="p-3 mx-auto w-full md:w-9/12 lg:w-8/12">
  {% include "pagination.njk" %}
  <div class="flex flex-col">
    <div class="flex flex-col flex-wrap gap-3 justify-center w-full sm:flex-row lg:justify-start">
      {% for plan in plans %}
        <a class="w-full text-white card md:w-80 bg-primary hover:bg-primary-focus hover:text-primary-content focus:bg-primary-focus focus:text-primary-content" 
           data-turbo-preload
           href="{{ plan.url }}">
          <div class="card-body">
            <h5 class="card-title">{{ plan.data.title }}</h5>
            <div class="h-4"></div>
            <p class="font-normal text-white">{{ plan.data.description }}</p>
          </div>
          <div class="justify-end p-4 card-actions">
          {% if plan.data.current %}
            <div class="p-1 badge badge-secondary">Current</div>
          {% endif %}
          {% if plan.data.start %}
            <div class="p-1 badge badge-outline">Start date: {{plan.data.start}}</div>
          {% endif %}
          </div>
        </a>
      {% endfor %}
    </div>
  </div>
  {% include "pagination.njk" %}
</main>