---
layout: base
eleventyNavigation:
  key: All Plans
  order: 1
eleventyImport:
  collections: ["plans"]
pagination:
  data: collections.plans
  size: 12
  alias: plans
meta:
  title: Bible Reading Plans Archive
  description: this is where you can find all our Bible Reading Plans.
---

{% include "today.njk" %}

<main class="mx-auto w-full p-3 md:w-9/12 lg:w-8/12">
  {% include "pagination.njk" %}
  <div class="flex flex-col">
    <div class="flex w-full flex-col flex-wrap justify-center sm:flex-row lg:justify-start gap-3">
      {% for plan in plans %}
        <a class="card w-full md:w-80 bg-primary text-white hover:bg-primary-focus hover:text-primary-content focus:bg-primary-focus focus:text-primary-content" 
           data-turbo-preload
           href="{{ plan.url }}">
          <div class="card-body">
            <h5 class="card-title">{{ plan.data.title }}</h5>
            <div class="h-4"></div>
            <p class="font-normal text-white">{{ plan.data.description }}</p>
          </div>
          <div class="card-actions justify-end p-4 ">
          {% if plan.data.current %}
            <div class="badge badge-secondary p-1">Current</div>
          {% endif %}
          {% if plan.data.start %}
            <div class="badge badge-outline p-1">Start date: {{plan.data.start}}</div>
          {% endif %}
          </div>
        </a>
      {% endfor %}
    </div>
  </div>
  {% include "pagination.njk" %}
</main>