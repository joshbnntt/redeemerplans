<section class="mx-auto w-full p-3 md:3/6 lg:w-4/12"
   x-data="reading">
<div class="alert mt-3 flex flex-row"
     x-data="today">
    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-6 h-6">
      <path stroke-linecap="round" stroke-linejoin="round" d="M12 6.042A8.967 8.967 0 006 3.75c-1.052 0-2.062.18-3 .512v14.25A8.987 8.987 0 016 18c2.305 0 4.408.867 6 2.292m0-14.25a8.966 8.966 0 016-2.292c1.052 0 2.062.18 3 .512v14.25A8.987 8.987 0 0018 18a8.967 8.967 0 00-6 2.292m0-14.25v14.25" />
      </svg>
    <div class="flex flex-col">
      <p class="font-bold text-left">Today
      </p>
      <p x-html="todayReading.readinglinks || todayReading.reading" x-show="todayReading" x-cloak>
      </p>
      <p class="text-left" x-show="todayReading.alt">
        <span class="font-semibold">Alternate:</span>
        <span x-html="todayReading.altReadingLinks || todayReading.alt"></span>
      </p>
    </div>
    <div x-data="{get checked() {return this.$store?.haveread?.days?.some(d => d.plan_day === todayDate)}}"
         x-show="$store.auth.user" x-cloak
         class="form-control">
      <label class="label cursor-pointer">
        <input type="checkbox" class="checkbox checkbox-primary" name="haveread" x-on:change="check" :checked="checked"/>
      </label>
    </div>
</div>
</section>