<header class="py-2 w-full text-xl bg-primary">
  <div class="flex flex-wrap justify-between items-center p-4 mx-auto max-w-screen-xl">
    <div class="font-bold text-white logo">
      <a href="/" data-turbo-preload>{{ site.title }}</a>
    </div> 
    <div x-data="logout"  :class="{'rounded-full ring ring-accent': typeof $store.auth.user !== 'undefined'}">
        <div class="dropdown dropdown-end">
          <label tabindex="0" 
                 class="btn btn-primary focus:btn-accent dark:btn-primary btn-circle avatar placeholder">
            <div class="w-10 rounded-full">
              
                <svg
                xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="w-6 h-6">
                  <path fill-rule="evenodd" d="M7.5 6a4.5 4.5 0 119 0 4.5 4.5 0 01-9 0zM3.751 20.105a8.25 8.25 0 0116.498 0 .75.75 0 01-.437.695A18.683 18.683 0 0112 22.5c-2.786 0-5.433-.608-7.812-1.7a.75.75 0 01-.437-.695z" clip-rule="evenodd" />
                  </svg>

            </div>
          </label>
          <ul x-show="!$store.auth.user"
            tabindex="0" 
            class="menu menu-sm dropdown-content mt-3 z-[1] p-2 shadow bg-base-100 rounded-box w-52">
             <li><button onClick="document.getElementById('tswitcher').showModal()">Change Translation</button></li>
             <li><a href="/login/">Login</a></li>
          </ul>
          <ul x-show="$store.auth.user" 
             tabindex="0" class="menu menu-sm dropdown-content mt-3 z-[1] p-2 shadow bg-base-100 rounded-box w-52">
            <li>
              <a class="justify-between" onClick="document.getElementById('profile').showModal()">
                <span x-text="$store.auth.user?.email"></span>
              </a>
            </li>
            <li><button onClick="document.getElementById('tswitcher').showModal()">Change Translation</button></li>
            <li>
              <a @click.prevent="logout">Logout</a>
            </li>
          </ul>
        </div>
    </div>
  </div>
</header>
{% include 'translationSwitcher.njk' %}
{% include 'userProfile.njk' %}