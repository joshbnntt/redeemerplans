<header class="w-full bg-primary  py-2 text-xl">
  <div class="mx-auto flex max-w-screen-xl flex-wrap items-center justify-between p-4">
    <div class="logo text-white font-bold">
      <a href="/" data-turbo-preload>{{ site.title }}</a>
    </div> 
    <div x-data="logout" >
        <div class="dropdown dropdown-end">
          <label tabindex="0" class="btn btn-primary focus:btn-accent dark:btn-primary btn-circle avatar placeholder">
            <div class="w-10 rounded-full">
              <svg x-show="!$store.auth.user"
                 xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-6 h-6">
                <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 6a3.75 3.75 0 11-7.5 0 3.75 3.75 0 017.5 0zM4.501 20.118a7.5 7.5 0 0114.998 0A17.933 17.933 0 0112 21.75c-2.676 0-5.216-.584-7.499-1.632z" />
                </svg>
                <svg x-show="$store.auth.user" x-cloak
                xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="w-6 h-6">
                  <path fill-rule="evenodd" d="M7.5 6a4.5 4.5 0 119 0 4.5 4.5 0 01-9 0zM3.751 20.105a8.25 8.25 0 0116.498 0 .75.75 0 01-.437.695A18.683 18.683 0 0112 22.5c-2.786 0-5.433-.608-7.812-1.7a.75.75 0 01-.437-.695z" clip-rule="evenodd" />
                  </svg>

            </div>
          </label>
          <ul x-show="!$store.auth.user"
            tabindex="0" 
            class="menu menu-sm dropdown-content mt-3 z-[1] p-2 shadow bg-base-100 rounded-box w-52">
             <li><a href="/login/">Login</a></li>
          </ul>
          <ul x-show="$store.auth.user"
             tabindex="0" class="menu menu-sm dropdown-content mt-3 z-[1] p-2 shadow bg-base-100 rounded-box w-52">
            <li>
              <a class="justify-between">
                <span x-text="$store.auth.user?.email"></span>
              </a>
            </li>
            <li>
              <a @click.prevent="logout">Logout</a>
            </li>
          </ul>
        </div>
    </div>
  </div>
</header>