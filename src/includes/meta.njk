{# We use eleventy-rss plugin absoluteUrl filter as helper for absolute URL generation #}

{# General #}
<meta name="description" content="{{ meta.description or site.description }}">
<meta name="generator" content="{{ eleventy.generator }}">

{# Open Graph #}
<meta property="og:site_name" content="{{ site.title }}">
<meta property="og:title" content="{{ meta.title or site.title }}">
<meta property="og:description" content="{{ meta.description or site.description }}">
<meta property="og:url" content="{{ page.url | url | absoluteUrl(site.baseUrl) }}">
<meta property="og:locale" content="{{  meta.locale or site.locale }}">

{%- if meta.image -%}
<meta property="og:image" content="{{ meta.image | url | absoluteUrl(site.baseUrl) }}">
{%- endif -%}
{# End Open Graph #}

{# Twitter #}
<meta name="twitter:card" content="{% if meta.image -%}summary_large_image{% else %}summary{% endif %}">
<meta name="twitter:title" content="{{ title or meta.title }}">
<meta name="twitter:description" content="{{ meta.description or site.description}}">
{%- if meta.image -%}
<meta property="twitter:image" content="{{ meta.image | url | absoluteUrl(site.baseUrl) }}">
{%- endif -%}
{# End Twitter #}


{# Manifest #}
<link rel="manifest" href="manifest.json">
<link rel="icon" href="/images/web/favicon.ico" sizes="any">
<meta name="mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-capable" content="yes">
<meta name="application-name" content="Redeemer Bible Reading Plans">
<meta name="apple-mobile-web-app-title" content="Redeemer Bible Reading Plans">
<meta name="theme-color" content="0c4a6e">
<meta name="msapplication-navbutton-color" content="0c4a6e">
<meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
<meta name="msapplication-starturl" content="/">
<meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">

<link rel="icon" sizes="192x192" href="/images/web/icon-192.png">
<link rel="apple-touch-icon" sizes="192x192" href="/images/web/icon-192.png">
<link rel="icon" sizes="512x512" href="/images/web/icon-512.png">
<link rel="apple-touch-icon" sizes="512x512" href="/images/web/icon-512.png">
<link rel="icon" href="/images/web/apple-touch-icon.png">
<link rel="apple-touch-icon" href="/images/web/apple-touch-icon.png">
{# End Manifest #}