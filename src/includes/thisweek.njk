<turbo-frame id="plan" loading="eager">
<div x-data="thisweek" x-init="fetchPlan()" class="flex flex-col">
    <div class="overflow-x-auto relative rounded-2xl">
        <table class="w-full text-left text-gray-500 rounded-lg dark:text-gray-400" x-data="readings">
            <caption class="p-5 text-xl font-semibold text-left text-white bg-primary dark:bg-primary dark:text-white">
                <div class="flex flex-col gap-1 justify-between mt-2 align-middle">
                   <div class="flex justify-between">
                    <h1 class="p-2">This Week's Reading</h1>
                    <button x-show="offset != 0" class="p-2 text-base font-extralight" @click="resetWeek">This week</button>
                   </div>
                    {# <a  x-data="{turboLoading: false}"
                        x-on:turbo:click="turboLoading = true"
                        href="/current/"
                        data-turbo-preload
                        class="px-3 py-2 text-sm font-medium text-center text-white rounded-md border border-base-300 hover:bg-base-300 hover:text-base-content focus:outline-none focus:ring-4 focus:ring-base-100">
                        <span x-show="!turboLoading">See the whole plan</span>
                        <span x-show="turboLoading" x-cloak>Loading<span class="loading loading-dots loading-xs"></span></span>
                    </a> #}
                    <div class="flex justify-between">
                        <button x-on:click="decrementOffset" class="px-3 py-2 text-sm font-medium text-center text-white rounded-md border border-base-300 hover:bg-base-300 hover:text-base-content focus:outline-none focus:ring-4 focus:ring-base-100 dark:border-gray-300 disabled:bg-gray-500 disabled:cursor-not-allowed" x-bind:disabled="!hasPrevWeek">Previous week</button>
                        <button x-on:click="incrementOffset" class="px-3 py-2 text-sm font-medium text-center text-white rounded-md border border-base-300 hover:bg-base-300 hover:text-base-content focus:outline-none focus:ring-4 focus:ring-base-100 dark:border-gray-300 disabled:bg-gray-500 disabled:cursor-not-allowed" x-bind:disabled="!hasNextWeek">Next week</button>
                    </div>
                </div>
                <p x-show="!isLoading && !readings && !error" class="text-white" x-cloak>Nothing to read this week.</p>
                <p x-show="error" x-text="error" class="text-error" x-cloak></p>
            </caption>
            <tbody x-show="readings" x-cloak class="border border-r border-b border-l border-base-300">
                <template x-for="(reading, index) in readings" :key="reading.id">
                    <tr :class="{ 
                     'border-b border-base-100 bg-base-300 text-base-content': isGraceOrLordsDay(reading.day), 
                     'border-b border-base-300 bg-base-100 text-base-content': !isGraceOrLordsDay(reading.day) 
                 }" :data-date="formatDate(reading.readingdate)">
                        <td class="px-6 py-4">
                            <div class="flex flex-col justify-center">
                                <span class="font-bold" x-text="getMonthShort(reading.readingdate)"></span>
                                <span class="font-mono text-xl countdown">
                                    <span :style="`--value:${getDayTwoDigits(reading.readingdate)};`" x-text="getDayTwoDigits(reading.readingdate)"></span>
                                </span>
                            </div>
                        </td>
                        <td class="px-6 py-4">
                            <h2 class="font-bold" x-text="getDayOfWeek(reading.readingdate)"></h2>
                            <ul>
                                {# <li x-text="reading.day"></li> #}
                                <li class="flex flex-wrap gap-1"
                                    x-html="getPassages(reading.day, reading.readinglinks)"></li>
                                <template x-if="reading.alt">
                                <li class="mt-2">
                                    <ul class="flex flex-col gap-0">
                                        <li class="font-semibold">Alternate:</li>
                                        <li class="flex flex-wrap gap-1" x-html="getPassages(reading.alt, reading.altReadinglinks)"></li>
                                    </ul>   
                                </li>
                                </template>
                            </ul>
                        </td>
                        <td x-data="{day:'', get checked() {return this.$store?.haveread?.days?.some(d => d.plan_day === this.day)}}" x-init="day = formatDate(reading.readingdate)"
                            x-show="$store.auth.user" x-cloak :data-day="day" class="px-6 py-4">
                            <div class="form-control">
                                <label class="cursor-pointer label">
                                    <input type="checkbox" class="checkbox checkbox-primary" name="haveread" x-on:change="check" :checked="checked"/>
                                </label>
                            </div>
                        </td>
                    </tr>
                </template>
                <tbody
                    x-show="isLoading && !readings">
                    {# x-show="isLoading && !readings" x-cloak #}
                    <tr class="text-white border-b border-sky-700 bg-accent">
                        <td class="px-6 py-4">
                            <span class="loading loading-bars loading-md"></span>
                        </td>
                    </tr>
                </tbody>
            </tbody>
        </table>
    </div>
</div>
</turbo-frame>