<div x-data="thisweek" x-init="fetchReadings()" class="flex flex-col"> 
     <div class="relative overflow-x-auto rounded-2xl"> 
  
             <table class="w-full rounded-lg text-left text-sm text-gray-500 dark:text-gray-400" > 
                 <caption class="bg-primary p-5 text-left text-lg font-semibold text-white dark:bg-primary dark:text-white" 
             > 
                    <div class="mt-2 flex justify-between align-middle">
                    <h1>This Week's Reading</h1>
            <a
                href="/current/"
              class="rounded-md border border-stone-500 px-3 py-2 text-center text-xs font-medium text-white hover:bg-stone-500
                hover:text-white focus:outline-none focus:ring-4 focus:ring-sky-800"
              >See the whole plan</a>
          </div>
              <p x-show="!readings" class="text-white">Loading...</p> 
                 </caption> 
  
                 <tbody x-show="readings" x-cloak> 
                     <template x-for="(reading, index) in readings" > 
                         <tr :class="{ 
                     'border-b border-sky-700 bg-accent text-white': isGraceOrLordsDay(reading.day), 
                     'border-b border-sky-700 bg-info text-white': !isGraceOrLordsDay(reading.day) 
                 }" :data-date="formatDate(reading.readingdate)" x-show="reading.readingdate !== '' && reading.readingdate >= currentWeek && reading.readingdate <= currentWeekEnd"> 
                             <td class="px-6 py-4">
                             <div class="flex flex-col justify-center">
                                <span class="font-bold" x-text="getMonthShort(reading.readingdate)"></span>
                                <span class="countdown font-mono text-xl">
                                <span :style="`--value:${getDayTwoDigits(reading.readingdate)};`" x-text="getDayTwoDigits(reading.readingdate)"></span>
                                </span>
                            </div>
                             </td> 
                             <td class="px-6 py-4"> 
                                 <h3 class="font-bold" x-text="getDayOfWeek(reading.readingdate)"></h3> 
                                 <ul> 
                                     <li x-text="reading.day"></li> 
                                     <li x-show="reading.alt" class="mt-2"> 
                                         <span class="font-semibold">Alternate:</span> 
                                         <span x-text="reading.alt"></span> 
                                     </li> 
                                 </ul> 
                             </td> 
                         </tr> 
                     </template> 
  
                 </tbody> 
             </table> 
  
 </div> 
 </div>