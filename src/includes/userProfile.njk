<dialog id="profile" class="modal" x-data="userProfile">
  <div class="modal-box dark:text-white">
    <h3 class="text-lg font-bold">Your Stats</h3>
      <div class="shadow stats stats-vertical sm:stats-horizontal">
        <div class="stat">
          <div class="stat-title">Days Read This Year</div>
          <div class="stat-value" x-text="yearCount"></div>
        </div>
        <div class="stat">
          <div class="stat-title">Total Days Read</div>
          <div class="stat-value" x-text="count"></div>
        </div>
        
      </div>
    <div class="p-4 h-12"></div>
    <div class="modal-action">
      <form method="dialog">
        <!-- if there is a button in form, it will close the modal -->
        <button class="btn">Close</button>
      </form>
    </div>
  </div>
</dialog>