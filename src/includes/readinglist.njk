<main class="mx-auto w-full p-3 md:w-7/12 lg:w-5/12">
<turbo-frame id="plan" data-turbo-action="replace">
  <div class="flex flex-col">
    <div class="relative overflow-x-auto rounded-2xl">
      <table class="w-full rounded-lg text-left text-gray-500 dark:text-gray-400" {% if start !== "" %}x-data="readings"{%endif%}>
        <caption class="bg-primary p-5 text-left text-lg font-semibold text-white dark:bg-primary dark:text-white">{{ title }}
          <p class="mt-1 text-sm font-light text-stone-300 dark:text-stone-200">
            {{ description }}</p>
          <div class="mt-2 flex gap-2">
            {% if currentplan %} 
              <a x-data="{turboLoading: false}"
                 x-on:turbo:click="turboLoading = true"
                href="/thisweek/"
                class="ml-1 rounded-md border border-base-300 px-3 py-2 text-center text-sm font-medium text-white hover:bg-base-300
                hover:text-base-content focus:outline-none focus:ring-4 focus:ring-sky-800">
                See this week's reading<span class="loading loading-dots loading-xs" x-show="turboLoading" x-cloak></span></a>
            {% endif %}
            <a
              {% if currentplan %}
                href="/currentplan.xml"
              {% else %}
              href="/subsplash/{{ title | slugify }}.xml"
              {% endif %}
              class="rounded-md border border-accent px-3 py-2 text-center font-medium text-white hover:bg-accent text-sm
                hover:text-white focus:outline-none focus:ring-4 focus:ring-accent-focus"
              target="_blank">Subsplash Link</a>
            
          </div>
        </caption>
        <tbody class="border-b border-l border-r border-base-300">
          {% for reading in plan %}
            {% if reading.day === "Grace Day" or reading.day === "Lord's Day"%}
              <tr class="border-t border-base-100 bg-base-300 text-base-content font-light" data-date="{% readingdate start, loop.index-1 %}">
            {% else %}
              <tr class="border-b border-base-300 bg-base-100 text-base-content" data-date="{% readingdate start, loop.index-1 %}">
            {% endif %}
                {% if start !== "" %}
                  <td class="px-6 py-4">
                    {% date start, loop.index-1 %}
                  </td>
                {% else %}
                  <td class="px-6 py-4">{{ loop.index }}</td>
                {% endif %}
                <td class="px-6 py-4">
                  <h3 class="font-bold">{% weekday start, loop.index-1 %}</h3>
                  <ul>
                    <li>{{ reading.day | safe }}</li>
                    {% if reading.alt and reading.alt !== "" %}
                        <li class="mt-2"><span class="font-semibold">Alternate:</span> {{ reading.alt | safe }}</li>
                    {% endif %}
                  </ul>
                </td>
                {% if start !== "" %}
                <td x-data="{day:'', get checked() {return this.$store?.haveread?.days?.some(d => d.plan_day === this.day)}}" x-init="day = '{% readingdate start, loop.index-1 %}'" 
                    x-show="$store.auth.user" x-cloak :data-day="day"
                    class="px-6 py-4"> 
                  <div class="form-control"> 
                    <label class="label cursor-pointer">
                      
                        <input type="checkbox" class="checkbox checkbox-primary" name="haveread" x-on:change="check" :checked="checked"/> 
                    </label> 
                  </div> 
                </td>
                {% endif %}
              </tr>
            {% endfor %}
          </tbody>
        </table>
      </div>
    </div>
    </turbo-frame>
  </main>