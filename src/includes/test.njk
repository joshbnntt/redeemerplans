<div x-data="{
    readings: null,
    title: null,
    description: null,
        currentWeek: '',
        currentWeekEnd: '',
        getWeekStart() {
            const today = new Date();
            const start = today.getDate() - today.getDay();
            const weekStart = new Date(today.setDate(start));
            return weekStart.toLocaleDateString('en-US', { month: '2-digit', day: '2-digit', year: 'numeric' });
        },
        getWeekEnd() {
            const weekStart = new Date(this.getWeekStart());
            const weekEnd = new Date(weekStart);
            weekEnd.setDate(weekEnd.getDate() + 6); // Assuming a week ends on the 7th day

            return weekEnd.toLocaleDateString('en-US', { month: '2-digit', day: '2-digit', year: 'numeric' });
        },
        fetchReadings() {
            fetch('/api/masterplan.json')
                .then(response => response.json())
                .then(data => {
                    console.log(data);
                    this.title = data.title;
                    this.description = data.description;
                    this.readings = data.plan;
                    this.currentWeek = this.getWeekStart();
                    this.currentWeekEnd = this.getWeekEnd();
                })
                .catch(error => {
                    console.error('Error:', error);
                });
        },

    formatDate(date) {
        const options = { month: '2-digit', day: '2-digit' };
        return new Date(date).toLocaleDateString('en-US', options);
    },

    getDayOfWeek(date) {
        const options = { weekday: 'long' };
        return new Date(date).toLocaleDateString('en-US', options);
    },

    isGraceOrLordsDay(day) {
        return day === 'Grace Day' || day === `Lord's Day`;
    },
}" x-init="fetchReadings()">
    <div class="container mx-auto px-4 py-8">
       
            <table class="w-full rounded-lg text-left text-sm text-gray-500 dark:text-gray-400" x-show="readings">
                <caption class="bg-primary p-5 text-left text-lg font-semibold text-white dark:bg-primary dark:text-white"
            ><h1>This Week's Reading</h1>
    
                </caption>
                <thead class="bg-white text-xs uppercase text-primary">
                    <tr>
                        <th scope="col" class="px-6 py-3">Day</th>
                        <th scope="col" class="px-6 py-3">Passages</th>
                    </tr>
                </thead>
                <tbody>
                    <template x-for="(reading, index) in readings" >
                        <tr :class="{
                    'border-b border-sky-700 bg-accent text-white': isGraceOrLordsDay(reading.day),
                    'border-b border-sky-700 bg-info text-white': !isGraceOrLordsDay(reading.day)
                }" :data-date="formatDate(reading.readingdate)" x-show="reading.readingdate !== '' && reading.readingdate >= currentWeek && reading.readingdate <= currentWeekEnd">
                            <td class="px-6 py-4" x-text="formatDate(reading.readingdate)"></td>
                            <td class="px-6 py-4">
                                <h3 class="font-bold" x-text="getDayOfWeek(reading.readingdate)"></h3>
                                <ul>
                                    <li x-text="reading.day"></li>
                                    <li class="mt-2">
                                        <span class="font-semibold">Alternate:</span>
                                        <span x-text="reading.alt" x-show="reading.alt !== ''"></span>
                                    </li>
                                </ul>
                            </td>
                        </tr>
                    </template>

                </tbody>
            </table>
    <p x-show="!readings" class="text-gray-500">Loading...</p>

</div>
</div>