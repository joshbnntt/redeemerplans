---
eleventyImport:
  collections: ["plans"]
pagination:
  data: collections.plans
  size: 1
  alias: plan
permalink: "/public/subsplash/{{ plan.data.title | slugify}}.xml"
---

<plan>
  {% for reading in plan.data.plan %}
    <reading>
      <day>{{ loop.index }}</day>
      {% set passages = reading.day | split(",") %}
      {% for passage in passages %}
        <passage>{{ passage | safe }}</passage>
      {% endfor %}
    </reading>
  {% endfor %}
</plan>
