{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "redirects": [
    { "source": "/thisweek", "destination": "/plan/", "permanent": false },
    { "source": "/thisweek/", "destination": "/plan/", "permanent": false },
    { "source": "/current", "destination": "/plan/", "permanent": false },
    { "source": "/current/", "destination": "/plan/", "permanent": false },
    { "source": "/login", "destination": "/settings/#account", "permanent": false },
    { "source": "/login/", "destination": "/settings/#account", "permanent": false }
  ],
  "schedules": {
    "plan-changeover": {
      "schedule": "5 0 * * *",
      "timezone": "America/Chicago",
      "path": "/api/cron/changeover",
      "requestMethod": "GET"
    }
  }
}
